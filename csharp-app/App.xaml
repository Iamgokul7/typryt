<Application x:Class="Typryt.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Ui/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Colour brushes. ThemeManager replaces these values for the light theme (frozen brushes).
                 Dark is the default. The first five names are the ones the older windows already use. -->
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#121212"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1C1C"/>
            <SolidColorBrush x:Key="Panel2Brush" Color="#2A2A2A"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D4D4D4"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#DE5C0A"/>
            <SolidColorBrush x:Key="CardShadowBrush" Color="#3A3A3A"/>
            <SolidColorBrush x:Key="ButtonShadowBrush" Color="#DE5C0A"/>
            <SolidColorBrush x:Key="LineBrush" Color="#3F3F3F"/>
            <SolidColorBrush x:Key="FocusBrush" Color="#DE5C0A"/>
            <!-- Text on accent fills is always black. -->
            <SolidColorBrush x:Key="OnAccentBrush" Color="#000000"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
