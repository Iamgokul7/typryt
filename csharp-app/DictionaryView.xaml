<UserControl x:Class="Typryt.DictionaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="{StaticResource SansFont}" FontSize="14">
    <ScrollViewer x:Name="DictionaryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalFirst">
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="1100"
                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid Margin="24,20,30,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left: search, the list, the count line -->
            <StackPanel Grid.Column="0">
                <ContentControl Style="{StaticResource HardCard}" Padding="24,18,24,22">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0,0,0,3" Padding="0,0,0,12">
                            <TextBlock Text="SEARCH" Style="{StaticResource Cap}"/>
                        </Border>
                        <TextBox x:Name="SearchBox" Style="{StaticResource HardInput}" Margin="0,16,0,0" Tag="Type to filter your words"
                                 AutomationProperties.Name="Search your words" TextChanged="Search_TextChanged"/>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource HardCard}" Margin="0,20,0,0" Padding="0" Height="360">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0,0,0,3" Padding="20,14">
                            <TextBlock Text="YOUR WORDS" Style="{StaticResource Cap}"/>
                        </Border>
                        <Grid>
                            <ListBox x:Name="WordList" Style="{StaticResource HardList}" ItemContainerStyle="{StaticResource WordRow}"
                                     SelectionChanged="WordList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Word}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Kind}" Margin="12,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Normal"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyText" Style="{StaticResource MonoText}" FontSize="15" Padding="20,32" TextWrapping="Wrap" IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>
                </ContentControl>

                <TextBlock x:Name="Status" Style="{StaticResource MonoText}" FontSize="14" FontWeight="Bold" Margin="0,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Right: add and remove -->
            <StackPanel Grid.Column="2">
                <ContentControl Style="{StaticResource HardCard}" Padding="24,18,24,24">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0,0,0,3" Padding="0,0,0,12">
                            <TextBlock Text="ADD A WORD" Style="{StaticResource Cap}"/>
                        </Border>
                        <TextBox x:Name="NewWordBox" Style="{StaticResource HardInput}" Margin="0,16,0,16" Tag="A word Typryt should leave alone"
                                 AutomationProperties.Name="Word to add" PreviewKeyDown="NewWord_PreviewKeyDown" TextChanged="NewWord_TextChanged"/>
                        <Button x:Name="AddButton" Style="{StaticResource HardButtonPrimary}" Content="Add" Height="52" FontSize="16" IsEnabled="False" Click="Add_Click"/>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource HardCard}" Margin="0,20,0,0" Padding="24,18,24,24">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0,0,0,3" Padding="0,0,0,12">
                            <TextBlock Text="REMOVE" Style="{StaticResource Cap}"/>
                        </Border>
                        <TextBlock x:Name="RemoveHint" Style="{StaticResource Hint}" FontSize="15" Margin="0,16,0,16" Text="Pick a word in the list first."/>
                        <Button x:Name="RemoveButton" Style="{StaticResource HardButton}" Content="Remove selected word" Height="52"
                                IsEnabled="False" Click="Remove_Click"/>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
