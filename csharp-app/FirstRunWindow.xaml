<Window x:Class="Typryt.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Typryt: choose apps"
        Width="460" Height="540"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C1E" Foreground="#F2F2F2"
        FontFamily="Segoe UI" FontSize="14">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Choose where Typryt may correct your text"
                       FontSize="17" FontWeight="SemiBold" Foreground="#E8620A"/>
            <TextBlock Text="Turn an app on to allow corrections in it. You can change this later."
                       Margin="0,6,0,12" TextWrapping="Wrap" Opacity="0.8"/>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" Content="Save" Click="Save_Click"
                HorizontalAlignment="Right" Padding="18,6"
                Background="#E8620A" Foreground="White" BorderThickness="0"
                Cursor="Hand" Margin="0,12,0,0"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AppList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  Margin="0,5" Foreground="#F2F2F2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
