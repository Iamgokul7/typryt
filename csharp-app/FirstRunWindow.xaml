<Window x:Class="Typryt.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Typryt: choose apps"
        Width="520" Height="680" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource SansFont}" FontSize="14">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="3" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar: the wordmark and a close button -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0,0,0,3">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource WindowButton}" Content="×" AutomationProperties.Name="Close"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="32" Height="32" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="3">
                            <TextBlock Text="T|" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource OnAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="ExtraBold">
                            <Run Text="Typryt"/><Run Text="." Foreground="{DynamicResource AccentBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Grid.Row="1" Margin="24,20,30,30">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock Text="Choose where Typryt may correct your text" FontFamily="{StaticResource MonoFont}" FontSize="19" FontWeight="ExtraBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Turn an app on to allow corrections in it. You can change this later." Style="{StaticResource Hint}" FontSize="15" Margin="0,8,0,0"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource HardButtonPrimary}" Content="Save" Click="Save_Click"
                        HorizontalAlignment="Right" Height="48" MinWidth="120" Margin="0,22,4,4"/>

                <ContentControl Style="{StaticResource HardCard}" Padding="24,8" Margin="0,0,6,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="AppList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource SwitchRow}" Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </ContentControl>
            </DockPanel>
        </Grid>
    </Border>
</Window>
