<UserControl x:Class="Typryt.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Typryt.Ui"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="{StaticResource SansFont}" FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1100" Margin="24,0,30,30" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="440"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left: status, counters, level -->
            <StackPanel Grid.Column="0">
                <ContentControl Style="{StaticResource HardCard}" Padding="24,0" MinHeight="104">
                    <Grid MinHeight="98">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,12">
                            <TextBlock x:Name="StatusTitle" Style="{StaticResource MonoText}" FontSize="26" FontWeight="ExtraBold" Text="Typryt is on"/>
                            <TextBlock x:Name="StatusSub" Style="{StaticResource Hint}" FontSize="15" Margin="0,6,0,0"
                                       Text="Fixes happen as you type, in the apps you allowed."/>
                        </StackPanel>
                        <CheckBox x:Name="HomeMasterSwitch" Grid.Column="1" Style="{StaticResource BigSwitch}" Margin="16,0,0,0" VerticalAlignment="Center"
                                  AutomationProperties.Name="Turn corrections on or off" Click="HomeMaster_Click"/>
                    </Grid>
                </ContentControl>

                <Grid Margin="0,20,0,0" Height="120">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="0" Style="{StaticResource HardCard}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" Padding="20,16">
                        <Grid>
                            <TextBlock Text="WORDS FIXED" Style="{StaticResource Cap}" Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Top"/>
                            <TextBlock x:Name="FixedCount" Style="{StaticResource MonoText}" Foreground="{DynamicResource OnAccentBrush}" FontSize="52" FontWeight="ExtraBold" VerticalAlignment="Bottom" Text="0"/>
                        </Grid>
                    </ContentControl>
                    <ContentControl Grid.Column="2" Style="{StaticResource HardCard}" Padding="20,16">
                        <Grid>
                            <TextBlock Text="TODAY" Style="{StaticResource Cap}" VerticalAlignment="Top"/>
                            <TextBlock x:Name="TodayCount" Style="{StaticResource MonoText}" FontSize="52" FontWeight="ExtraBold" VerticalAlignment="Bottom" Text="0"/>
                        </Grid>
                    </ContentControl>
                    <ContentControl Grid.Column="4" Style="{StaticResource HardCard}" Padding="20,16">
                        <Grid>
                            <TextBlock Text="UNDONE" Style="{StaticResource Cap}" VerticalAlignment="Top"/>
                            <TextBlock x:Name="UndoneCount" Style="{StaticResource MonoText}" FontSize="52" FontWeight="ExtraBold" VerticalAlignment="Bottom" Text="0"/>
                        </Grid>
                    </ContentControl>
                </Grid>

                <ContentControl Style="{StaticResource HardCard}" Margin="0,20,0,0" Padding="24,20">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CORRECTION LEVEL" Style="{StaticResource Cap}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LevelName" Style="{StaticResource MonoText}" FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Right" Text="MEDIUM"/>
                        </Grid>
                        <ui:StopSlider x:Name="LevelSlider" Style="{StaticResource HardSlider}" Margin="0,14,0,0"
                                       AutomationProperties.Name="Correction level" AutomationProperties.AutomationId="LevelSlider"
                                       ValueChanged="LevelSlider_ValueChanged"/>
                        <ui:StopPanel Height="40" Margin="0,8,0,0">
                            <ToggleButton x:Name="LevelLow" Tag="Low" Content="Low" Style="{StaticResource LevelLabel}" Click="Level_Click"/>
                            <ToggleButton x:Name="LevelMedium" Tag="Medium" Content="Medium" Style="{StaticResource LevelLabel}" Click="Level_Click"/>
                            <ToggleButton x:Name="LevelHigh" Tag="High" Content="High" Style="{StaticResource LevelLabel}" Click="Level_Click"/>
                            <ToggleButton x:Name="LevelExtreme" Tag="Extreme" Content="Extreme" Style="{StaticResource LevelLabel}" Click="Level_Click"/>
                        </ui:StopPanel>
                        <TextBlock x:Name="LevelDescription" Style="{StaticResource Hint}" FontSize="15" Margin="0,14,0,0"/>
                    </StackPanel>
                </ContentControl>
            </StackPanel>

            <!-- Right: recent corrections -->
            <ContentControl Grid.Column="2" Style="{StaticResource HardCard}" VerticalAlignment="Top" Height="488" Padding="22,20">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0,0,0,3" Padding="0,0,0,14">
                        <TextBlock Text="RECENT CORRECTIONS" Style="{StaticResource Cap}"/>
                    </Border>
                    <ListBox x:Name="RecentList" Style="{StaticResource HardList}" ItemContainerStyle="{StaticResource HistoryRow}" Focusable="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,8">
                                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="16" TextWrapping="Wrap">
                                            <Run Text="{Binding From, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" TextDecorations="Strikethrough"/>
                                            <Run Text=" → "/>
                                            <Run Text="{Binding To, Mode=OneWay}" FontWeight="Bold"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding When}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Tag}" Margin="10,0,0,0"
                                            Visibility="{Binding Undone, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="UNDONE" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </ContentControl>
        </Grid>
    </ScrollViewer>
</UserControl>
