<Window x:Class="Typryt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Typryt"
        xmlns:ui="clr-namespace:Typryt.Ui"
        Title="Typryt"
        Width="1100" Height="740"
        MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource SansFont}" FontSize="14">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Frame" BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="3" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <ui:GridBackdrop x:Name="Backdrop"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0,0,0,3">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" Content="–" AutomationProperties.Name="Minimize"
                                    WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click"/>
                            <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="□" AutomationProperties.Name="Maximize"
                                    WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click"/>
                            <Button x:Name="CloseButton" Style="{StaticResource WindowButton}" Content="×" AutomationProperties.Name="Close"
                                    WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Border Width="32" Height="32" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="3">
                                <TextBlock Text="T|" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource OnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="ExtraBold"
                                       AutomationProperties.Name="Typryt">
                                <Run Text="Typryt"/><Run Text="." Foreground="{DynamicResource AccentBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Navigation and the three screens -->
                <TabControl Grid.Row="1" Style="{StaticResource NavTabs}">
                    <TabItem Header="Home">
                        <local:HomeView x:Name="Home"/>
                    </TabItem>
                    <TabItem Header="Settings">
                        <local:SettingsView x:Name="Settings"/>
                    </TabItem>
                    <TabItem Header="Dictionary">
                        <local:DictionaryView/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>
