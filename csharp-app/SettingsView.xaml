<UserControl x:Class="Typryt.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Typryt.Ui"
             Focusable="True"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="{StaticResource SansFont}" FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalFirst">
        <Grid MaxWidth="1100" Margin="24,20,30,30" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Left column -->
            <StackPanel Grid.Column="0">
                <ContentControl Style="{StaticResource HardCard}" Padding="24,18,24,8">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0,0,0,3" Padding="0,0,0,12">
                            <TextBlock Text="GENERAL" Style="{StaticResource Cap}"/>
                        </Border>
                        <CheckBox x:Name="MasterBox" Style="{StaticResource SwitchRow}" Content="Turn corrections on" Click="Master_Click"/>
                        <CheckBox x:Name="StartupBox" Style="{StaticResource SwitchRow}" Content="Start Typryt when Windows starts" Click="Startup_Click"/>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource HardCard}" Margin="0,22,0,0" Padding="24,18,24,8">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0,0,0,3" Padding="0,0,0,12">
                            <TextBlock Text="CORRECTIONS" Style="{StaticResource Cap}"/>
                        </Border>
                        <CheckBox x:Name="AbbreviationsBox" Style="{StaticResource SwitchRow}" Content="Expand abbreviations (brb, idk, asap)" Click="Abbreviations_Click"/>
                        <CheckBox x:Name="CapitalizeBox" Style="{StaticResource SwitchRow}" Content="Capitalize after a full stop, ! or ?" Click="Capitalize_Click"/>
                        <CheckBox x:Name="LearningBox" Style="{StaticResource SwitchRow}" Content="Learn my words and remember undone corrections" Click="Learning_Click"/>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource HardCard}" Margin="0,22,0,0" Padding="24,18,24,24">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0,0,0,3" Padding="0,0,0,12">
                            <TextBlock Text="UNDO AND TOAST" Style="{StaticResource Cap}"/>
                        </Border>

                        <Grid MinHeight="56" Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowLabel}" Text="Undo key"/>
                                <TextBlock x:Name="UndoHint" Style="{StaticResource Hint}" Margin="0,2,16,0"
                                           Text="Press Alt and this letter within a few seconds of a correction to undo it."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="UndoLabel" Style="{StaticResource MonoText}" FontSize="18" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,14,4" Text="Alt + U"/>
                                <Button x:Name="UndoChangeButton" Style="{StaticResource HardButton}" Content="Change" Click="UndoChange_Click"/>
                            </StackPanel>
                        </Grid>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,2,0,0" Margin="0,0,0,0"/>

                        <TextBlock Style="{StaticResource RowLabel}" Margin="0,14,0,8" Text="The toast stays on screen for"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ToastLabel" Grid.Column="1" Style="{StaticResource MonoText}" FontSize="18" FontWeight="ExtraBold"
                                       TextAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0" Text="3 s"/>
                            <ui:StopSlider x:Name="ToastSlider" Style="{StaticResource HardSlider}" Minimum="1" Maximum="5" Margin="0,0,16,0"
                                           AutomationProperties.Name="Toast duration in seconds" ValueChanged="ToastSlider_ValueChanged"/>
                        </Grid>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,2,0,0" Margin="0,2,0,0"/>

                        <TextBlock Style="{StaticResource RowLabel}" Margin="0,14,0,10" Text="After an undo, keep the word uncorrected for"/>
                        <ComboBox x:Name="BlockBox" Style="{StaticResource HardDropdown}" SelectionChanged="Block_SelectionChanged" AutomationProperties.Name="Keep uncorrected for">
                            <ComboBoxItem Content="1 hour" Tag="1"/>
                            <ComboBoxItem Content="24 hours" Tag="24"/>
                            <ComboBoxItem Content="7 days" Tag="168"/>
                            <ComboBoxItem Content="Until I remove it" Tag="0"/>
                        </ComboBox>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,2,0,0" Margin="0,14,0,0"/>

                        <TextBlock Style="{StaticResource RowLabel}" Margin="0,14,0,10" Text="Show the toast in this corner"/>
                        <ComboBox x:Name="CornerBox" Style="{StaticResource HardDropdown}" SelectionChanged="Corner_SelectionChanged" AutomationProperties.Name="Toast corner">
                            <ComboBoxItem Content="Top left" Tag="top-left"/>
                            <ComboBoxItem Content="Top right" Tag="top-right"/>
                            <ComboBoxItem Content="Bottom left" Tag="bottom-left"/>
                            <ComboBoxItem Content="Bottom right" Tag="bottom-right"/>
                        </ComboBox>
                    </StackPanel>
                </ContentControl>
            </StackPanel>

            <!-- Right column -->
            <StackPanel Grid.Column="2">
                <ContentControl Style="{StaticResource HardCard}" Padding="24,18,24,24">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0,0,0,3" Padding="0,0,0,12">
                            <TextBlock Text="APPEARANCE" Style="{StaticResource Cap}"/>
                        </Border>
                        <TextBlock Style="{StaticResource RowLabel}" Margin="0,16,0,10" Text="Theme"/>
                        <UniformGrid Rows="1">
                            <ToggleButton x:Name="ThemeDarkButton" Style="{StaticResource HardToggle}" Content="Dark" Margin="0,0,14,4" Click="ThemeDark_Click"/>
                            <ToggleButton x:Name="ThemeBox" Style="{StaticResource HardToggle}" Content="Light" Click="Theme_Click"/>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource RowLabel}" Margin="0,20,0,10" Text="Animated grid background"/>
                        <UniformGrid Rows="1">
                            <ToggleButton x:Name="GridOnButton" Style="{StaticResource HardToggle}" Content="On" Margin="0,0,14,4" Padding="8,0" Click="GridOn_Click"/>
                            <ToggleButton x:Name="GridOffButton" Style="{StaticResource HardToggle}" Content="Off" Padding="8,0" Click="GridOff_Click"/>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="It pauses when the window is hidden and follows Windows’ animation setting."/>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource HardCard}" Margin="0,22,0,0" Padding="24,18,24,8">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0,0,0,3" Padding="0,0,0,12">
                            <TextBlock Text="APPS WHERE CORRECTIONS RUN" Style="{StaticResource Cap}"/>
                        </Border>
                        <ItemsControl x:Name="AppList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource SwitchRow}" Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}" Click="App_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource HardCard}" Margin="0,22,0,0" Padding="24,18,24,18">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource TextPrimaryBrush}" BorderThickness="0,0,0,3" Padding="0,0,0,12">
                            <TextBlock Text="WINDOWS COMPATIBILITY" Style="{StaticResource Cap}"/>
                        </Border>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Text="Windows' text suggestions can delete a space right after a correction in Chrome (roughly 1 in 3 with the same misspelling). To stop it: Settings → Time &amp; language → Typing → turn off 'Show text suggestions as I type on the hardware keyboard'."/>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
