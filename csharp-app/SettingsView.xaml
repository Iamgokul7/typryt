<UserControl x:Class="Typryt.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="Segoe UI" FontSize="14">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel>
            <TextBlock Text="General" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <CheckBox x:Name="MasterBox" Content="Turn corrections on" Click="Master_Click"/>
            </Border>

            <TextBlock Text="Corrections" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="AbbreviationsBox" Content="Expand abbreviations (brb, idk, asap)" Click="Abbreviations_Click" Margin="0,4"/>
                    <CheckBox x:Name="CapitalizeBox" Content="Capitalize after a full stop, ! or ?" Click="Capitalize_Click" Margin="0,4"/>
                    <CheckBox x:Name="LearningBox" Content="Learn my words and remember undone corrections" Click="Learning_Click" Margin="0,4"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Undo" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="UndoChangeButton" Content="Change" Click="UndoChange_Click"
                                Padding="12,4" Cursor="Hand"/>
                        <TextBlock x:Name="UndoLabel" VerticalAlignment="Center" Text="Alt + U"/>
                    </DockPanel>
                    <TextBlock x:Name="UndoHint" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Press Alt and this letter within a few seconds of a correction to undo it."/>
                    <TextBlock Margin="0,12,0,4" Text="The toast stays on screen for"/>
                    <DockPanel>
                        <TextBlock x:Name="ToastLabel" DockPanel.Dock="Right" Width="70" TextAlignment="Right" Text="3 s"/>
                        <Slider x:Name="ToastSlider" Minimum="1" Maximum="5" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="ToastSlider_ValueChanged"/>
                    </DockPanel>
                    <TextBlock Margin="0,12,0,4" Text="Show the toast in this corner"/>
                    <ComboBox x:Name="CornerBox" SelectionChanged="Corner_SelectionChanged">
                        <ComboBoxItem Content="Top left" Tag="top-left"/>
                        <ComboBoxItem Content="Top right" Tag="top-right"/>
                        <ComboBoxItem Content="Bottom left" Tag="bottom-left"/>
                        <ComboBoxItem Content="Bottom right" Tag="bottom-right"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <TextBlock Text="Appearance" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <CheckBox x:Name="ThemeBox" Content="Light theme" Click="Theme_Click"/>
            </Border>

            <TextBlock Text="Apps where corrections run" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}">
                <ItemsControl x:Name="AppList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                      Click="App_Click" Margin="0,3"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
