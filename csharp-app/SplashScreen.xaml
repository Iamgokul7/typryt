<Window x:Class="Typryt.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Typryt splash"
        Width="360" Height="200"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="WordText" Text="" FontFamily="Segoe UI Semibold" FontSize="48"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock x:Name="CursorText" Text="|" FontFamily="Segoe UI Semibold" FontSize="48"
                       Foreground="{DynamicResource AccentBrush}" Opacity="1"/>
        </StackPanel>
    </Grid>
</Window>
